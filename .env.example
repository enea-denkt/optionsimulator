# Keyless pass-through for Cboe's public delayed-quotes feed.
#
# Only needed for production builds on static hosting (GitHub Pages, S3, ...),
# because Cboe does not allow cross-origin browser reads. `npm run dev` does not
# need it — the Vite dev server proxies /cboe/* instead.
#
# Deploy proxy/cloudflare-worker.js and put its URL here. There is no API key
# involved anywhere, so this value is safe to commit and safe to ship in the bundle.
VITE_MARKET_PROXY=https://market-proxy.your-subdomain.workers.dev
